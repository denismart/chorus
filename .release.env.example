# Скопировать в .release.env (он в .gitignore) и заполнить.
# Токен: https://authors.curseforge.com/account/api-tokens
CF_API_TOKEN=
# ID проектов на CurseForge (видны на странице проекта, блок About Project)
CF_PROJECT_Chorus=
CF_PROJECT_Chorus_ruRU_Midnight=
# Версия игры для загрузки на CurseForge
GAME_VERSION=12.1.0
# Все версии игры для файла на CurseForge (как в ## Interface в .toc), через пробел
GAME_VERSIONS="12.0.0 12.0.1 12.0.5 12.0.7 12.1.0 12.1.5"
# Адрес проекта ядра на CurseForge: пакеты указывают его как обязательную зависимость
CF_CORE_SLUG=chorus
